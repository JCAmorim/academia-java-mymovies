meta {
  name: Atualiza Nota do Filme
  type: http
  seq: 7
}

patch {
  url: {{baseURL}}/api/movies/21/rating
  body: json
  auth: bearer
}

auth:bearer {
  token: {{user_token}}
}

body:json {
  {
    "rating": 9.0
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
